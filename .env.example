DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=ces_app
DB_PASSWORD=replace_with_local_password
DB_NAME=ces_portal
APP_TIME_ZONE=Asia/Manila

# Phone-reachable demo URL, e.g. http://phone-reachable-demo-host:3000/volunteer
VOLUNTEER_SIGNUP_URL=

# Optional post-MVP academic/demo venue map. Restart the app after changing configuration.
# OpenStreetMap iframe: no billing account or API key required. Configuration is public.
# One approved CES/demo venue name/address (max 250 Unicode code points); never Volunteer data.
# Demonstration context only when no managed Activity is selected.
# A selected Activity always uses its own venue; missing coordinates do not fall back here.
CES_MAP_VENUE_NAME=
# Decimal coordinates only: latitude [-90, 90], longitude [-180, 180]. No scientific notation.
# Use modest human-viewing demo traffic; no bulk/offline downloading or background tile fetching.
CES_MAP_LATITUDE=
CES_MAP_LONGITUDE=
